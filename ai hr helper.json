        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"full_name\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"phone_number\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"email\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"gender\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"age\": {\n      \"type\": [\"integer\", \"null\"]\n    },\n    \"location\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"education\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"job_title\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"skills\": {\n      \"type\": [\"array\", \"null\"],\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"experience_years\": {\n      \"type\": [\"integer\", \"null\"]\n    },\n    \"cv_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 100\n    },\n    \"cv_rating\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\n        \"Excellent\",\n        \"Very Good\",\n        \"Good\",\n        \"Average\",\n        \"Poor\",\n        null\n      ]\n    },\n    \"evaluation\": {\n      \"type\": [\"string\", \"null\"]\n    }\n  },\n  \"required\": [\n    \"full_name\",\n    \"phone_number\",\n    \"email\",\n    \"gender\",\n    \"age\",\n    \"location\",\n    \"education\",\n    \"job_title\",\n    \"skills\",\n    \"experience_years\",\n    \"cv_score\",\n    \"cv_rating\",\n    \"evaluation\"\n  ]\n}"
